# =====================================================================
# Annuaire LDAP de DÉMONSTRATION de la BCM (faux agents, faux mots de passe)
# Chargé par le serveur LDAP intégré de Spring Boot au démarrage.
# En production, on se connecte au vrai annuaire (Active Directory) à la place.
#
# Organisation : une branche (ou) par direction, et pour chaque agent :
#   uid              = identifiant de connexion (compte Windows)
#   employeeNumber   = matricule
#   departmentNumber = direction
#   title            = poste
#
# Mot de passe de tous les comptes de démonstration : Bcm@2026
# =====================================================================

dn: dc=bcm,dc=mr
objectClass: top
objectClass: domain
dc: bcm

dn: ou=personnes,dc=bcm,dc=mr
objectClass: top
objectClass: organizationalUnit
ou: personnes
description: Agents de la Banque Centrale de Mauritanie

