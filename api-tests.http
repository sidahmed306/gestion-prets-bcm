### Variables
@baseUrl = http://localhost:8080

###############################################
# AUTHENTIFICATION (à exécuter en premier)
###############################################

### Connexion : le jeton est récupéré dans la variable token
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "motDePasse": "Admin@BCM2026"
}

@token = {{login.response.body.token}}

### Mon profil
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{token}}

### Lister les utilisateurs (ADMIN uniquement)
GET {{baseUrl}}/api/utilisateurs
Authorization: Bearer {{token}}

### Créer un utilisateur (ADMIN uniquement)
POST {{baseUrl}}/api/utilisateurs
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "username": "fatma.salem",
  "motDePasse": "Gestion2026",
  "nomComplet": "Fatma Mint Salem",
  "role": "GESTIONNAIRE"
}

###############################################
# EMPLOYÉS
###############################################

### Liste des employés
GET {{baseUrl}}/api/employes
Authorization: Bearer {{token}}

### Un employé par id
GET {{baseUrl}}/api/employes/1
Authorization: Bearer {{token}}

### Recherche par nom
GET {{baseUrl}}/api/employes/recherche?nom=sid
Authorization: Bearer {{token}}

### Créer un employé
POST {{baseUrl}}/api/employes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "matricule": "MAT100",
  "nom": "Test Employe",
  "departement": "Informatique",
  "email": "test@bcm.mr"
}

### Modifier un employé
PUT {{baseUrl}}/api/employes/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "matricule": "MAT001",
  "nom": "Ahmed Sidi",
  "departement": "IT",
  "email": "ahmed@bcm.mr"
}

###############################################
# CATÉGORIES
###############################################

### Liste des catégories
GET {{baseUrl}}/api/categories
Authorization: Bearer {{token}}

### Créer une catégorie
POST {{baseUrl}}/api/categories
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "code": "TEL",
  "libelle": "Téléphone"
}

###############################################
# MATÉRIELS
###############################################

### Liste des matériels
GET {{baseUrl}}/api/materiels
Authorization: Bearer {{token}}

### Matériels disponibles
GET {{baseUrl}}/api/materiels/disponibles
Authorization: Bearer {{token}}

### Recherche par désignation
GET {{baseUrl}}/api/materiels/recherche?designation=dell
Authorization: Bearer {{token}}

### Créer un matériel
POST {{baseUrl}}/api/materiels
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "numeroInventaire": "INV999",
  "designation": "Test Materiel",
  "categorieId": 1,
  "marque": "Test",
  "modele": "X1",
  "etatPhysique": "Bon"
}

###############################################
# PRÊTS
###############################################

### Liste des prêts
GET {{baseUrl}}/api/prets
Authorization: Bearer {{token}}

### Prêts en cours
GET {{baseUrl}}/api/prets/en-cours
Authorization: Bearer {{token}}

### Prêts en retard
GET {{baseUrl}}/api/prets/en-retard
Authorization: Bearer {{token}}

### Historique des prêts d'un employé
GET {{baseUrl}}/api/prets/employe/1
Authorization: Bearer {{token}}

### Historique des prêts d'un matériel
GET {{baseUrl}}/api/prets/materiel/4
Authorization: Bearer {{token}}

### Créer un prêt (matériel disponible)
POST {{baseUrl}}/api/prets
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "materielId": 2,
  "employeId": 2,
  "datePret": "2026-10-08",
  "dateRetourPrevue": "2026-10-20",
  "commentaire": "Test via REST Client"
}

### TEST RÈGLE MÉTIER : re-prêter un matériel déjà en cours doit échouer (409)
POST {{baseUrl}}/api/prets
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "materielId": 1,
  "employeId": 2,
  "datePret": "2026-10-08",
  "dateRetourPrevue": "2026-10-15"
}

### Restituer un prêt (remplace l'id par celui obtenu après création)
POST {{baseUrl}}/api/prets/1/retour
Authorization: Bearer {{token}}
Content-Type: application/json

{}

### Envoyer les rappels de retard par email (emails visibles dans MailDev : http://localhost:1080)
POST {{baseUrl}}/api/prets/rappels-retard
Authorization: Bearer {{token}}

###############################################
# COMPTABILITÉ
###############################################

### Synthèse comptable (aujourd'hui)
GET {{baseUrl}}/api/comptabilite/synthese
Authorization: Bearer {{token}}

### Synthèse comptable à la clôture de l'exercice
GET {{baseUrl}}/api/comptabilite/synthese?date=2025-12-31
Authorization: Bearer {{token}}

### Plan d'amortissement d'un matériel
GET {{baseUrl}}/api/comptabilite/materiels/1/plan
Authorization: Bearer {{token}}

###############################################
# ANNUAIRE D'ENTREPRISE (LDAP)
###############################################

### Connexion : Responsable du développement (DSI) → GESTIONNAIRE (mot de passe : Bcm@2026)
# @name loginAnnuaire
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "sidi.cheikh",
  "motDePasse": "Bcm@2026"
}

### Connexion : Directrice de la Comptabilité → LECTEUR
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "fatma.salem",
  "motDePasse": "Bcm@2026"
}

### Connexion : Comptable (ni DSI, ni directeur) → 403 accès refusé
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "oumar.kane",
  "motDePasse": "Bcm@2026"
}

### Synchroniser les employés avec l'annuaire (ADMIN)
POST {{baseUrl}}/api/annuaire/synchroniser-employes
Authorization: Bearer {{token}}
